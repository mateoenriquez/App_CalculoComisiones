# Variables de entorno del Sistema de Comisiones
# Copiar este archivo como config/.env y completar los valores.
# NUNCA subir config/.env al repositorio (ver .gitignore).

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_comisiones
DB_USERNAME=root
DB_PASSWORD=tu_contraseña_aqui

# --- Aplicación ---
DEBUG=true
# En producción: DEBUG=false

# --- Seguridad ---
# En producción, generar un salt nuevo con:
#   vendor/bin/cake security generate_token
# y configurarlo aquí:
# SECURITY_SALT=nuevo_salt_de_produccion_seguro

# --- Tests (opcional) ---
# Para tests de integración MySQL (no los unitarios que usan SQLite):
# DATABASE_TEST_URL=mysql://root:contraseña@127.0.0.1/sistema_comisiones_test
